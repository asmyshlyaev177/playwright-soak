{
  "name": "playwright-soak",
  "version": "1.0.0",
  "description": "Catch memory leaks in Playwright tests. Repeat a user flow a few hundred times, force GC, and fail the test if DOM nodes, listeners or heap keep piling up.",
  "keywords": [
    "playwright",
    "memory-leak",
    "memory-leak-detection",
    "soak-test",
    "soak-testing",
    "stress-test",
    "memory",
    "leak",
    "heap",
    "gc",
    "cdp",
    "chrome-devtools-protocol",
    "testing",
    "e2e",
    "spa",
    "performance",
    "tanstack-intent"
  ],
  "license": "MIT",
  "author": {
    "name": "Aleksandr Smyshliaev",
    "email": "asmyshlyaev177@gmail.com",
    "url": "https://asmyshlyaev177.dev"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/asmyshlyaev177/playwright-soak.git"
  },
  "bugs": {
    "url": "https://github.com/asmyshlyaev177/playwright-soak/issues"
  },
  "homepage": "https://github.com/asmyshlyaev177/playwright-soak#readme",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "skills"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "typecheck:example": "pnpm run build && pnpm --filter example-tanstack typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "playwright test",
    "test:example": "pnpm run build && pnpm --filter example-tanstack test",
    "skills": "intent validate",
    "skills:stale": "intent stale",
    "prepare": "husky",
    "example:dev": "pnpm --filter example-tanstack dev",
    "prepack": "pnpm run build"
  },
  "lint-staged": {
    "*.{ts,tsx,mts,cts,js,jsx,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css,html}": [
      "prettier --write"
    ]
  },
  "peerDependencies": {
    "@playwright/test": ">=1.30.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.62.0",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/npm": "^13.1.3",
    "@semantic-release/release-notes-generator": "^14.1.0",
    "@tanstack/intent": "^0.3.6",
    "@types/node": "^22.10.0",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.6.2",
    "semantic-release": "^25.0.2",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.46.0"
  },
  "packageManager": "pnpm@9.15.0"
}
